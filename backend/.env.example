CONVERSATION_MAX_QUESTION_LENGTH=8000
CONVERSATION_STALE_PENDING_SECONDS=300
DOCUMENT_ANALYSIS_MAX_CHUNKS=200
DOCUMENT_ANALYSIS_MAX_ESTIMATED_INPUT_TOKENS=60000
DOCUMENT_ANALYSIS_BATCH_ESTIMATED_TOKENS=6000
DOCUMENT_ANALYSIS_MAX_PROVIDER_CALLS=12
DOCUMENT_ANALYSIS_MAX_DURATION_SECONDS=240
DOCUMENT_ANALYSIS_MAX_OUTPUT_ITEMS=40
DOCUMENT_ANALYSIS_MAX_OUTPUT_TOKENS=4096
GEMINI_API_KEY=
