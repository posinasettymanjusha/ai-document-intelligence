DOCUMENT_CHUNK_OVERLAP=150
DOCUMENT_MINIMUM_CHUNK_SIZE=100
EMBEDDING_DIMENSION=768
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=gemini-embedding-2
