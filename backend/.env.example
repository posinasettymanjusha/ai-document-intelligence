# Required for PostgreSQL persistence and Supabase Auth/Storage.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional upload limit; defaults to 10 MiB.
MAX_DOCUMENT_SIZE_BYTES=10485760
DOCUMENT_CHUNK_SIZE=1200
DOCUMENT_CHUNK_OVERLAP=150
DOCUMENT_MINIMUM_CHUNK_SIZE=100
EMBEDDING_DIMENSION=768
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_BATCH_SIZE=16
GEMINI_GENERATION_MODEL=gemini-3.8-flash
GEMINI_GENERATION_TIMEOUT_SECONDS=30
CONVERSATION_MAX_HISTORY_TURNS=8
CONVERSATION_MAX_HISTORY_CHARACTERS=12000
CONVERSATION_MAX_QUESTION_LENGTH=8000
CONVERSATION_STALE_PENDING_SECONDS=300
GEMINI_API_KEY=
